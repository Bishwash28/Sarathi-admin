# Copy this file to .env — this is how you switch backends. No .env at
# all (or an unrecognized value) falls back to "demo" automatically.
#
# Options: demo | supabase | mysql | mongodb
VITE_BACKEND=demo

# --- Supabase (only used when VITE_BACKEND=supabase) ---
# Find these under Project Settings → API in the Supabase dashboard.
# See src/connection/supabase/README.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- MySQL / MongoDB (only used when VITE_BACKEND=mysql or mongodb) ---
# The URL of the small Express API server you run separately — see
# src/connection/mysql/README.md or src/connection/mongodb/README.md.
VITE_API_BASE_URL=http://localhost:4000/api
